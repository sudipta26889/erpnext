# TaskPilot ERPNext fork - production stack env
# Copy to .env and fill in real values. Generate secrets with:
#   openssl rand -hex 24        (DB_PASSWORD)
#   openssl rand -base64 24     (ADMIN_PASSWORD)

# --- Custom image (built locally from the fork, never pulled from a registry) ---
CUSTOM_IMAGE=taskpilot-erpnext
CUSTOM_TAG=main-bd7a6f82
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# --- External PostgreSQL (remote instance; db+user pre-provisioned, no superuser creds - site is
# --- created with --no-setup-db, so these are consumed directly, not via a root password) ---
DB_TYPE=postgres
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- External Redis (shared instance; host:port/db form, inline auth, NO redis:// prefix -
# --- the configurator's `bench set-config` command prepends that itself). Format:
# ---   :<password>@<host>:<port>/<db>
# --- Convention: db 1 = cache, db 2 = queue (also used for socketio). ---
REDIS_CACHE=
REDIS_QUEUE=

# --- Gunicorn tuning ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Frontend / nginx ---
HTTP_PUBLISH_PORT=4410
FRAPPE_SITE_NAME_HEADER=erp.localhost
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# --- Site bootstrap (consumed by our own new-site command, not by compose itself) ---
SITE_NAME=erp.localhost
ADMIN_PASSWORD=

# --- TaskPilot integration (applied to the site via ./apply-taskpilot-settings.sh) ---
TASKPILOT_API_URL=
TASKPILOT_WORKSPACE_SLUG=
TASKPILOT_API_KEY=

# Paperclip (AI cofounder). Board API key created 2026-08-06, 90 day TTL.
PAPERCLIP_URL=https://paperclip.sudiptadhara.in
PAPERCLIP_COMPANY_ID=06bb12c4-648e-4e05-a5ef-e32a8ee3ec06
PAPERCLIP_AGENT_ID=d9654bd8-6382-4c3b-9b9b-050d533a59a8
PAPERCLIP_BOARD_API_KEY=
ERPNEXT_MCP_URL=http://nuc.lan:4410
# ERPNext API key/secret for the AI service user are deliberately NOT stored
# here -- connect-paperclip.sh takes them inline, exported in the same shell
# right before running it, and never persists them to disk. See the comment
# in that script.
